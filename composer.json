{
    "name": "grafida/shell-php",
    "description": "PHP worker side of Grafida Shell",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/grafida/shell-php",
    "authors": [
        {
            "name": "Nicholas K. Dionysopoulos",
            "homepage": "https://www.dionysopoulos.me/about-me"
        }
    ],
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "Grafida\\Shell\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grafida\\Shell\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "linter:check": "phpstan analyse --no-progress"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    }
}
